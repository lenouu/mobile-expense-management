# ---------------------------------------------------------------------
# TEMPLATE - copy this file to `application.properties` and fill it in.
#
#   cp application.properties.example application.properties
#
# `application.properties` itself is NOT committed (it is in backend/.gitignore) because it
# holds this machine's real database password and JWT signing key. This template is what a
# fresh clone, a teammate or a Jenkins job starts from.
# ---------------------------------------------------------------------
spring.application.name=expense-management-backend

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# Hibernate creates the tables, not the database. Create it once:
#   CREATE DATABASE expense_management;
spring.datasource.url=jdbc:postgresql://localhost:5432/expense_management
spring.datasource.username=postgres
# <-- PUT YOUR POSTGRES PASSWORD HERE
spring.datasource.password=CHANGE_ME
# Fail fast when the database is down (default 30s), so GET /api/admin/health answers quickly.
spring.datasource.hikari.connection-timeout=5000
server.port=8083
# DANGER: 'create' drops and recreates every table on each start, so all data is lost on
# restart. It is what makes the development seeds run every boot. Replace with 'validate'
# once Flyway migrations exist.
spring.jpa.hibernate.ddl-auto=create
spring.jpa.show-sql=true

# ---------------------------------------------------------------------
# JWT (stateless authentication)
# ---------------------------------------------------------------------
# HS256 is symmetric: this one secret both signs and verifies tokens. Anyone holding it can mint
# a token for any user id and any role, so it must stay server-side.
#
# Must be at least 32 bytes, or the app refuses to start. Generate one with:
#   openssl rand -base64 48
app.security.jwt.secret=CHANGE_ME_AT_LEAST_32_BYTES_OF_RANDOM_MATERIAL
app.security.jwt.expiration-minutes=60
app.security.jwt.issuer=expense-management-backend

# ---------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------
# Only matters for a browser client (web build, Swagger UI); a native app ignores it.
# http://localhost:8081 is the Expo web dev server.
app.cors.allowed-origins=http://localhost:3000,http://localhost:5173,http://localhost:8081

# ---------------------------------------------------------------------
# Password reset email (US06)
# ---------------------------------------------------------------------
# No SMTP is declared here on purpose. Spring Boot binds SPRING_MAIL_HOST, SPRING_MAIL_PORT,
# SPRING_MAIL_USERNAME and SPRING_MAIL_PASSWORD from the environment automatically, and creates
# the mail sender only when SPRING_MAIL_HOST is set.
#
# With no host configured the application still starts: the reset flow runs, but the link is
# written to the log instead of being emailed, which keeps local development testable.
app.auth.password-reset.link-base-url=http://localhost:8081/reset-password
app.auth.password-reset.from=no-reply@finflow.local

# ---------------------------------------------------------------------
# Error responses
# ---------------------------------------------------------------------
# Never leak a stack trace or the internal exception message to a client.
#
# NOTE the property names. Spring Boot 4 RENAMED these from server.error.* to
# spring.web.error.*. The old names still appear in Boot's metadata, but only
# as a "replacement" alias - they are ignored, so using them silently leaves
# stack traces switched on.
spring.web.error.include-stacktrace=never
spring.web.error.include-message=never

# ---------------------------------------------------------------------
# OpenAPI / Swagger UI
# ---------------------------------------------------------------------
#   UI:   http://localhost:8083/swagger-ui.html
#   JSON: http://localhost:8083/v3/api-docs
# Both are permitted anonymously in SecurityConfig, so anyone who can reach the app can read the
# whole API surface. Before deploying, set springdoc.api-docs.enabled=false and
# springdoc.swagger-ui.enabled=false and remove the doc paths from
# SecurityConfig.PUBLIC_GET_ENDPOINTS.
springdoc.api-docs.enabled=true
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.enabled=true
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.operations-sorter=method
springdoc.swagger-ui.tags-sorter=alpha
springdoc.swagger-ui.try-it-out-enabled=true
springdoc.swagger-ui.display-request-duration=true

# ---------------------------------------------------------------------
# Development seed data
# ---------------------------------------------------------------------
# On startup inserts 22 test accounts - 20 USER and 2 ADMIN - every one ACTIVE with the shared
# password: Password123!
#
#   Admin logins: admin.amina / admin.youssef    (all other seeds are USER)
#
# DEVELOPMENT ONLY. These are known credentials written straight into the database; set this to
# false (or delete the line) before deploying. The class is @ConditionalOnProperty, so an absent
# property means no seeding.
app.seed.enabled=true

# ---------------------------------------------------------------------
# Pagination limits
# ---------------------------------------------------------------------
# Caps the ?size= parameter on every Pageable endpoint. Without it a client can request the
# entire users table in one call, which is a cheap denial of service and a memory spike.
spring.data.web.pageable.default-page-size=20
spring.data.web.pageable.max-page-size=100
