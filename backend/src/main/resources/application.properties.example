spring.application.name=expense-management-backend
spring.datasource.url=jdbc:postgresql://localhost:5432/expense_management
spring.datasource.username=postgres
spring.datasource.password=root
# Fail fast when the database is down (default 30s), so GET /api/admin/health answers quickly.
spring.datasource.hikari.connection-timeout=5000
server.port=8083
spring.jpa.hibernate.ddl-auto=create



spring.jpa.show-sql=true
app.security.jwt.secret=dev-only-secret-change-me-0123456789abcdef
app.security.jwt.expiration-minutes=60
app.security.jwt.issuer=expense-management-backend

app.cors.allowed-origins=http://localhost:3000,http://localhost:5173,http://localhost:8081

app.auth.password-reset.link-base-url=${PASSWORD_RESET_LINK_BASE_URL:http://localhost:8081/reset-password}
app.auth.password-reset.from=${PASSWORD_RESET_FROM:no-reply@finflow.local}


spring.web.error.include-stacktrace=never
spring.web.error.include-message=never
springdoc.api-docs.enabled=true
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.enabled=true
springdoc.swagger-ui.path=/swagger-ui.html
# Keep the operation list in a predictable order rather than the order the
# scanner happened to find the controllers.
springdoc.swagger-ui.operations-sorter=method
springdoc.swagger-ui.tags-sorter=alpha
# Lets "Try it out" actually fire requests, and shows how long each took.
springdoc.swagger-ui.try-it-out-enabled=true
springdoc.swagger-ui.display-request-duration=true


app.seed.enabled=true

# ---------------------------------------------------------------------
# Pagination limits
# ---------------------------------------------------------------------
# Caps the ?size= parameter on every Pageable endpoint. Without it a client
# can request the entire users table in one call, which is a cheap denial of
# service and a memory spike on the heap.
spring.data.web.pageable.default-page-size=20
spring.data.web.pageable.max-page-size=100

# ---------------------------------------------------------------------
# Profile picture uploads
# ---------------------------------------------------------------------
# Where avatars are written. Outside src/main/resources on purpose: that directory is packaged
# into the jar, so anything saved there is part of the build output and lost on the next rebuild.
# This path is on the VPS disk and must be in the backup procedure.
app.uploads.dir=${UPLOADS_DIR:./uploads}

# Spring's multipart default is 1 MB, below a phone photo. The service re-checks the size itself;
# these limits stop an oversized body from being buffered at all.
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=6MB

# ---------------------------------------------------------------------
# Receipt reading (AI)
# ---------------------------------------------------------------------
# The key lives HERE, on the server, and is never sent to the app. Set DEEPSEEK_API_KEY
# in the environment (or paste the key after the colon) and restart the backend.
#
#   PowerShell:  $env:DEEPSEEK_API_KEY = "sk-..."
#
# With no key the backend still starts; POST /api/receipts/scan answers 503 with a
# message saying the key is missing. The photo itself is never stored.
app.ai.deepseek.api-key=${DEEPSEEK_API_KEY:}
app.ai.deepseek.base-url=https://api.deepseek.com
# DeepSeek-V4.1-Flash is the id the vision-capable model answers to.
app.ai.deepseek.model=deepseek-flash
# A hard-to-read receipt takes a while; this bounds the wait.
app.ai.deepseek.timeout-seconds=120